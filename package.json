{
  "name": "smart-family-finance",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "build:cloudflare": "opennextjs-cloudflare build",
    "preview": "wrangler dev",
    "start": "next start",
    "lint": "next lint",
    "db:seed-admin": "node --env-file=.env.local scripts/seed-admin.mjs",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "wrangler d1 migrations apply smart-family-finance-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply smart-family-finance-db --remote",
    "deploy": "echo '⚠️ NEXT+CF ONLY: Using opennextjs-cloudflare pipeline' && opennextjs-cloudflare build && opennextjs-cloudflare deploy"
  },
  "dependencies": {
    "@hookform/resolvers": "^3.9.0",
    "@radix-ui/react-dialog": "^1.1.1",
    "@radix-ui/react-dropdown-menu": "^2.1.1",
    "@radix-ui/react-label": "^2.1.0",
    "@radix-ui/react-select": "^2.1.1",
    "@radix-ui/react-slot": "^1.1.0",
    "@radix-ui/react-toast": "^1.2.23",
    "better-auth": "^0.8.0",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.1",
    "date-fns": "^3.6.0",
    "drizzle-orm": "^0.33.0",
    "lucide-react": "^0.446.0",
    "next": "latest",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-hook-form": "^7.53.0",
    "tailwind-merge": "^2.5.2",
    "tailwindcss-animate": "^1.0.7",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260906.1",
    "@opennextjs/cloudflare": "^1.20.6",
    "@types/node": "^20.16.5",
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "autoprefixer": "^10.5.5",
    "drizzle-kit": "^0.24.2",
    "postcss": "^8.5.28",
    "tailwindcss": "^3.4.11",
    "typescript": "^5.6.2",
    "wrangler": "^4.129.0"
  }
}
