# ============================================
# Smart Family Finance - Environment Variables
# ============================================
# Copy this file to .env.local and fill in your values
# IMPORTANT: Never commit .env.local to version control

# Authentication Secret (REQUIRED - generate a secure random string at least 32 characters)
BETTER_AUTH_SECRET=your-secure-random-secret-at-least-32-chars

# Application URLs
BETTER_AUTH_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000
APP_URL=http://localhost:8787

# Admin Setup Token (REQUIRED - generate a secure random token, use once)
ADMIN_SETUP_TOKEN=generate-a-secure-random-token-here

# Admin User Credentials (REQUIRED - minimum 8 characters for password)
ADMIN_NAME=Family Admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=your-secure-password-at-least-8-chars